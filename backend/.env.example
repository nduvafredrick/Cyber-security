# Backend configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
INGEST_API_KEY=replace-with-an-ingest-key
METRICS_API_KEY=replace-with-a-separate-metrics-key
CORS_ORIGIN=http://localhost:5173
LOG_RETENTION_DAYS=90
ADMIN_USER=admin
# Development only. In production provide ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=replace-this-development-password
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
ADMIN_PASSWORD_HASH=
