# Docker Compose environment
# All secrets must be set before running docker compose up

JWT_SECRET=generate-a-long-random-value-with-openssl-rand-hex-32
INGEST_API_KEY=generate-an-ingest-key-with-openssl-rand-hex-20
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=generate-with-node-e-console.log-bcryptjs.hashSync-password-12
CORS_ORIGIN=http://localhost:3001
LOG_RETENTION_DAYS=90
NODE_ENV=production
PORT=3001
